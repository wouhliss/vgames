  "query": "UPDATE jobs\n           SET state = 'queued', run_at = now(), attempts = 0, finished_at = NULL,\n               locked_by = NULL, locked_until = NULL\n           WHERE id = $1 AND state = ANY($2)\n           RETURNING id, kind, state, attempts, max_attempts, last_error, run_at, created_at, finished_at",
