  "query": "SELECT id, kind, state, attempts, max_attempts, last_error, run_at, created_at, finished_at\n           FROM jobs\n           WHERE ($1::uuid IS NULL OR id < $1)\n             AND ($2::text IS NULL OR state = $2)\n             AND ($3::text IS NULL OR kind = $3)\n           ORDER BY id DESC LIMIT $4",
