# vgames-api configuration. Copy to .env for local development.
# Every variable is read and validated at startup; the API refuses to start on
# a missing or malformed value (fail fast, no silent defaults for secrets).

# --- Core -------------------------------------------------------------------
VGAMES_BIND_ADDR=127.0.0.1:8080
# Public base URL clients use to reach this server (no trailing slash).
VGAMES_PUBLIC_URL=http://localhost:8080
VGAMES_SERVER_NAME="vgames dev server"
# Stable server identity (UUID). Generated once, never changed.
VGAMES_SERVER_ID=00000000-0000-7000-8000-000000000000
# App role: DML only. Migrations run with DATABASE_MIGRATION_URL (table owner).
# In local dev both can be the same superuser.
DATABASE_URL=postgres://vgames:vgames-dev-only@127.0.0.1:5432/vgames
DATABASE_MIGRATION_URL=postgres://vgames:vgames-dev-only@127.0.0.1:5432/vgames
VGAMES_LOG=info,vgames_api=debug
VGAMES_LOG_FORMAT=pretty          # pretty | json

# --- Trust root (docs/architecture/01-security.md) ---------------------------
# Public half of the OFFLINE root key (`vgames keys init-root`). Base64, 32 bytes.
# The private root key must never be on the server.
VGAMES_ROOT_PUBLIC_KEY=

# --- Discord OAuth2 (confidential client, scope: identify) --------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be registered in the Discord developer portal exactly as written.
DISCORD_REDIRECT_URI=http://localhost:8080/v1/auth/discord/callback
# First sign-in with this Discord user id becomes the server owner.
VGAMES_BOOTSTRAP_OWNER_DISCORD_ID=

# --- Object storage ---------------------------------------------------------
VGAMES_STORAGE_BACKEND=fs          # gcs | fs (fs = local dev/tests only)
VGAMES_FS_STORAGE_ROOT=./.data/objects
# Secret for signing fs-backend URLs (32+ random bytes, base64). Dev only.
VGAMES_FS_URL_SIGNING_KEY=
GCS_BUCKET_PACKAGES=
GCS_BUCKET_SAVES=
GCS_BUCKET_ASSETS=
# Path to a service-account JSON key, or leave empty to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Only for the local emulator (docker compose service `gcs`).
STORAGE_EMULATOR_HOST=

# --- Metadata providers -------------------------------------------------------
# IGDB uses Twitch app credentials (client-credentials grant).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Steam store endpoints are public; no key needed. Set to false to disable.
VGAMES_METADATA_STEAM_ENABLED=true

# --- Limits -------------------------------------------------------------------
VGAMES_SAVE_QUOTA_BYTES_PER_PACKAGE=536870912
VGAMES_SIGNED_URL_TTL_SECONDS=21600
