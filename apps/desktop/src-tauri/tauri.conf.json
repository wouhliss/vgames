{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vgames",
  "identifier": "app.vgames.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "vgames",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#101216"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: vgimg: http://vgimg.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: vgimg: http://vgimg.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "capabilities": ["main", "overlay"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "publisher": "vgames",
    "category": "Game",
    "shortDescription": "Fast, secure launcher for vgames servers",
    "longDescription": "vgames connects to a vgames server of your choice to install, update and play packages, sync cloud saves, and play with friends.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/wouhliss/vgames/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["vgames"]
      }
    }
  }
}
