{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main launcher window. Deliberately minimal: every feature goes through vgames' own typed commands (src/commands), which validate input in Rust. Do not add fs, shell, http or dialog permissions here \u2014 implement a command instead. The allow-* list must match MAIN_WINDOW_COMMANDS in src/commands/names.rs (a test checks it).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-ready",
    "allow-app-info",
    "allow-servers-list",
    "allow-server-preview",
    "allow-server-confirm",
    "allow-server-switch",
    "allow-server-remove",
    "allow-auth-start",
    "allow-auth-open-browser",
    "allow-auth-submit-code",
    "allow-auth-cancel",
    "allow-auth-sign-out",
    "allow-auth-token-storage",
    "allow-libraries-list",
    "allow-library-pick-folder",
    "allow-library-add",
    "allow-library-set-default",
    "allow-library-remove",
    "allow-shortcut-create",
    "allow-game-launch",
    "allow-game-stop",
    "allow-updater-status",
    "allow-updater-check",
    "allow-updater-whats-new",
    "allow-updater-install",
    "allow-social-connection",
    "allow-social-settings-get",
    "allow-social-settings-set",
    "allow-friends-list",
    "allow-friend-code-create",
    "allow-friend-request-send",
    "allow-friend-accept",
    "allow-friend-decline",
    "allow-friend-remove",
    "allow-user-block",
    "allow-user-unblock",
    "allow-blocks-list",
    "allow-user-profile",
    "allow-conversations-list",
    "allow-conversation-open-direct",
    "allow-conversation-create-party",
    "allow-messages-list",
    "allow-message-send",
    "allow-message-retry",
    "allow-conversation-mark-read",
    "allow-typing-start",
    "allow-contact-security",
    "allow-contact-set-verified",
    "allow-contact-trust-device",
    "allow-devices-list",
    "allow-device-revoke",
    "allow-invites-list",
    "allow-invite-send",
    "allow-invite-accept",
    "allow-invite-decline",
    "allow-invite-cancel",
    "allow-package-overlays-list",
    "allow-package-overlay-set",
    "allow-catalog-list",
    "allow-catalog-genres",
    "allow-package-details",
    "allow-install-plan",
    "allow-install-start",
    "allow-downloads-list",
    "allow-download-pause",
    "allow-download-resume",
    "allow-download-retry",
    "allow-download-remove",
    "allow-download-cancel",
    "allow-downloads-reorder",
    "allow-downloads-history-clear",
    "allow-download-settings-get",
    "allow-download-settings-set",
    "allow-collections-list",
    "allow-collection-create",
    "allow-collection-rename",
    "allow-collection-delete",
    "allow-collections-reorder",
    "allow-collection-add-package",
    "allow-collection-remove-package",
    "allow-favorite-set",
    "allow-installs-list",
    "allow-install-update",
    "allow-install-verify",
    "allow-install-resume",
    "allow-install-move",
    "allow-install-uninstall-plan",
    "allow-install-uninstall",
    "allow-install-open-folder",
    "allow-account-sessions",
    "allow-account-session-revoke"
  ]
}
