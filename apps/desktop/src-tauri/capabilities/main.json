{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main launcher window. Deliberately minimal: every feature goes through vgames' own typed commands (src/commands), which validate input in Rust. Do not add fs, shell, http or dialog permissions here \u2014 implement a command instead. The allow-* list must match MAIN_WINDOW_COMMANDS in src/commands/names.rs (a test checks it).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-ready",
    "allow-app-info",
    "allow-servers-list",
    "allow-server-preview",
    "allow-server-confirm",
    "allow-server-switch",
    "allow-server-remove",
    "allow-auth-start",
    "allow-auth-open-browser",
    "allow-auth-submit-code",
    "allow-auth-cancel",
    "allow-auth-sign-out",
    "allow-auth-token-storage",
    "allow-updater-status",
    "allow-updater-check",
    "allow-updater-whats-new",
    "allow-updater-install",
    "allow-social-connection",
    "allow-social-settings-get",
    "allow-social-settings-set",
    "allow-friends-list",
    "allow-friend-code-create",
    "allow-friend-request-send",
    "allow-friend-accept",
    "allow-friend-decline",
    "allow-friend-remove",
    "allow-user-block",
    "allow-user-unblock",
    "allow-blocks-list",
    "allow-user-profile"
  ]
}
