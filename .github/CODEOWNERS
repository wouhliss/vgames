/.cargo/                                    @wouhliss   # team: maintainers
/.changes/                                  @wouhliss   # team: maintainers (every agent writes fragments)
/docs/                                      @wouhliss   # team: maintainers
/infra/                                     @wouhliss   # team: maintainers (humans provision)

